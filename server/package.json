{
  "name": "qingchuan-h5-server",
  "version": "1.0.0",
  "private": true,
  "description": "青川数字艺术 H5 平台后端 —— Express 4 + better-sqlite3 + 裸 SQL",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
