# ── 服务 ──────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── 数据库 ────────────────────────────────────────────
# DB=sqlite | mysql   （开关名与 scripts/dialect.py 保持一致，见 ARCHITECTURE §3.1）
DB=sqlite
SQLITE_PATH=./data/qingchuan.db

# 仅 DB=mysql 时需要
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=qingchuan

corsOrigins 说明｜
# ── 跨域 ──────────────────────────────────────────────
# 前端页面源（逗号分隔）。前端带 token 头，不能用 *，必须回显匹配来源。
# 本地 dev(5173) + dist 静态预览(3000) 都在内；上线后改为真实域名。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:3000

# ── 鉴权 ──────────────────────────────────────────────
# 必填，缺失则启动失败（ARCHITECTURE §4.3 fail-fast）
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── 分页 ──────────────────────────────────────────────
PAGE_SIZE_MAX=100
PAGE_SIZE_DEFAULT=15
