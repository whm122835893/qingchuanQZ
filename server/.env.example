# ── 服务 ──────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── 数据库 ────────────────────────────────────────────
# DB=sqlite | mysql   （开关名与 scripts/dialect.py 保持一致，见 ARCHITECTURE §3.1）
DB=sqlite
SQLITE_PATH=./data/qingchuan.db

# 仅 DB=mysql 时需要
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=qingchuan

# ── 鉴权 ──────────────────────────────────────────────
# 必填，缺失则启动失败（ARCHITECTURE §4.3 fail-fast）
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── 分页 ──────────────────────────────────────────────
PAGE_SIZE_MAX=100
PAGE_SIZE_DEFAULT=15
